# ==========================================
# Bridge API Environment Configuration
# ==========================================
# Copy this file to '.env' and adjust the values
# as needed for your environment (e.g., dev or prod).

# ------------------------------------------
# General Application Configuration
# ------------------------------------------
# The hostname for your API application (used in prod realm redirect URIs & internal routing)
APP_HOSTNAME=brug-tot-brug.casteleijn.com

# The hostname for your Keycloak service (used for internal/external routing)
KEYCLOAK_HOSTNAME=auth.brug-tot-brug.casteleijn.com

# The only hostname that may serve the Keycloak admin console (KC_HOSTNAME_ADMIN).
# Keycloak cannot refuse /admin/ on other hostnames by itself: the gateway must
# return 404 for /admin/ on KEYCLOAK_HOSTNAME (see README.md).
KEYCLOAK_ADMIN_HOSTNAME=admin.brug-tot-brug.casteleijn.com

# Production: serve the admin console only on the tailnet (see README.md).
# A full URL, overrides KEYCLOAK_PROTOCOL + KEYCLOAK_ADMIN_HOSTNAME for KC_HOSTNAME_ADMIN.
# KEYCLOAK_ADMIN_URL=https://omarchy.tail0118fa.ts.net:8443
# Localhost port that `tailscale serve` forwards to (bound to 127.0.0.1 only).
# KEYCLOAK_ADMIN_LOCAL_PORT=8180

# ------------------------------------------
# App Database (PostgreSQL)
# ------------------------------------------
APP_POSTGRES_DB=bridge_app
APP_POSTGRES_USER=bridge_user
APP_POSTGRES_PASSWORD=bridge_password_secure

# ------------------------------------------
# Keycloak Database (PostgreSQL)
# ------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_password_secure

# ------------------------------------------
# Keycloak Initial Admin Setup
# ------------------------------------------
# Bootstrap admin of the master realm. Only Keycloak uses it; the API does not.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password_secure

# ------------------------------------------
# Keycloak Realm Configuration
# ------------------------------------------
# Which realm config file to import (bridge-realm-dev.json or bridge-realm-prod.json)
KEYCLOAK_REALM_IMPORT_FILE=bridge-realm-dev.json

# The ID/Name of the realm to be created
KEYCLOAK_APP_REALM=bridge-realm

# The Client ID for the app to connect
KEYCLOAK_CLIENT_ID=bridge-client

# Secret of the bridge-api-admin client: the API's service account in the app realm,
# limited to manage-users/view-users. Generate one with: openssl rand -hex 32
KEYCLOAK_API_ADMIN_CLIENT_SECRET=change_me_api_admin_secret

# The initial admin user to be created inside your realm
KEYCLOAK_USER_ADMIN_USERNAME=admin
KEYCLOAK_USER_ADMIN_PASSWORD=admin_realm_password_secure

# Keycloak protocol
KEYCLOAK_PROTOCOL=http