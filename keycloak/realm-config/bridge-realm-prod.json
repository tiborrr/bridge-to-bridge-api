{
  "id": "${KEYCLOAK_APP_REALM:bridge-realm}",
  "realm": "${KEYCLOAK_APP_REALM:bridge-realm}",
  "enabled": true,
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID:bridge-client}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "https://${APP_HOSTNAME}/*",
        "bridgeapp://login-callback",
        "bridgeapp://*"
      ],
      "webOrigins": [
        "https://${APP_HOSTNAME}"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "bridge-api-admin",
      "name": "Bridge API (invites users)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${KEYCLOAK_API_ADMIN_CLIENT_SECRET:change-me-api-admin-secret}",
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "service_account",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "kc-admin-api"
      ]
    }
  ],
  "users": [
    {
      "username": "${KEYCLOAK_USER_ADMIN_USERNAME:admin}",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_USER_ADMIN_PASSWORD:admin}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-bridge-api-admin",
      "enabled": true,
      "serviceAccountClientId": "bridge-api-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "bridge-api-admin",
        "roles": [
          "manage-users",
          "view-users"
        ]
      }
    ]
  }
}
