{
  "id": "${KEYCLOAK_APP_REALM:bridge-realm}",
  "realm": "${KEYCLOAK_APP_REALM:bridge-realm}",
  "loginTheme": "brug-tot-brug",
  "enabled": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID:bridge-client}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "https://${APP_HOSTNAME}/*",
        "bridgeapp://login-callback"
      ],
      "webOrigins": [
        "https://${APP_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${APP_HOSTNAME}/*##bridgeapp://login-callback"
      },
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "bridge-api-admin",
      "name": "Bridge API (invites users)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${KEYCLOAK_API_ADMIN_CLIENT_SECRET:change-me-api-admin-secret}",
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "service_account",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "kc-admin-api"
      ]
    }
  ],
  "users": [
    {
      "username": "${KEYCLOAK_USER_ADMIN_USERNAME:admin}",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_USER_ADMIN_PASSWORD:admin}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-bridge-api-admin",
      "enabled": true,
      "serviceAccountClientId": "bridge-api-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "bridge-api-admin",
        "roles": [
          "manage-users",
          "view-users"
        ]
      }
    ]
  }
}
